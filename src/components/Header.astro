---
import { SITE, NAV, BRAND } from '../config/site';
import { withBase, assetUrl } from '../utils/url';
import ThemeToggle from './ThemeToggle.astro';

/* Đánh dấu mục menu đang mở. So khớp theo đường dẫn đã gắn base. */
const path = Astro.url.pathname;
const isCurrent = (href: string) => {
  const full = withBase(href);
  if (href === '/') return path === full || path === full.replace(/\/$/, '');
  return path.startsWith(full);
};
---

<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href={withBase('/')}>
      {
        BRAND.enabled ? (
          <img
            class="mark brand-mark"
            src={assetUrl(BRAND.logoMark)}
            alt={BRAND.logoAlt}
            width="34"
            height="34"
            decoding="async"
          />
        ) : (
          <svg class="mark" viewBox="0 0 32 32" aria-hidden="true" fill="none">
            <circle cx="16" cy="16" r="15" stroke="var(--brand)" stroke-width="2" />
            <path
              d="M10 20c0-4.4 2.7-8 6-8s6 3.6 6 8"
              stroke="var(--brand)"
              stroke-width="2"
              stroke-linecap="round"
            />
            <circle cx="16" cy="9.5" r="2.4" fill="var(--accent)" />
          </svg>
        )
      }
      <span class="logo-text">
        <span class="logo-title">{SITE.shortTitle}</span>
        {BRAND.enabled && BRAND.byline && <span class="logo-byline">{BRAND.byline}</span>}
      </span>
    </a>

    <div class="header-right">
      <nav class="site-nav" aria-label="Điều hướng chính">
        <ul>
          {
            NAV.map((item) => (
              <li>
                <a href={withBase(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <ThemeToggle />

      {/* Menu di động dùng <details> — hoạt động cả khi tắt JavaScript */}
      <details class="nav-toggle">
        <summary aria-label="Mở menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <div class="nav-panel">
          <nav class="container" aria-label="Điều hướng di động">
            <ul>
              {
                NAV.map((item) => (
                  <li>
                    <a href={withBase(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>
