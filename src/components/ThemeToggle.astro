---
/**
 * Nút chuyển sáng/tối.
 *
 * Mặc định website theo cài đặt hệ điều hành (CSS `prefers-color-scheme`).
 * Nút này chỉ để người đọc ghi đè thủ công; lựa chọn lưu trong localStorage.
 * Không có JavaScript thì nút ẩn đi và website vẫn hiển thị đúng theo hệ điều hành.
 */
---

<button
  class="theme-toggle"
  type="button"
  id="theme-toggle"
  hidden
  aria-label="Chuyển chế độ sáng / tối"
  title="Chuyển chế độ sáng / tối"
>
  <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.hidden = false;

    function current() {
      var attr = document.documentElement.getAttribute('data-theme');
      if (attr) return attr;
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    btn.addEventListener('click', function () {
      var next = current() === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch (e) {}
      btn.setAttribute('aria-label', next === 'dark' ? 'Chuyển sang chế độ sáng' : 'Chuyển sang chế độ tối');
    });
  })();
</script>
